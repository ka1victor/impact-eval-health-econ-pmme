  "desvios": [
    {
      "data": "2026-10-26",
      "item": "Linhas da figura no CSV",
      "situacao": "O §5 pede a figura dos pesos na mesma escala, mas o §3 só lista P1h-1 a P1h-3.",
      "resolucao": "Os seis pesos da figura (5β, 10β, −γ, θ_UF, θ_UF + θ_reg, θ_UF + θ_reg + θ_mun) vão para o CSV com id_linha = FIG e papel descritivo, sem teste nem correção múltipla, para que a figura seja lida de output/ (regra de proveniência)."
    },
    {
      "data": "2026-10-26",
      "item": "p unilateral das linhas de km",
      "situacao": "O §3 pede p unilateral em toda linha; para K5 e K10 o protocolo não diz o método.",
      "resolucao": "p de H0: K ≤ 0 pelo método delta, como o EP e o IC dessas linhas; o Fieller dá o IC 95% e o limite inferior unilateral (conjunto de 90%). Pelo Fieller, H0: K ≤ 0 equivale a H0: β ≤ 0, porque γ < 0. As linhas são descritivas e não substituem o teste bilateral do P1a."
    },
    {
      "data": "2026-10-26",
      "item": "Alcance do portão",
      "situacao": "O §2 manda conferir 'os coeficientes e os EP com cluster por conjunto'; o §3 aplica o mesmo portão às sensibilidades.",
      "resolucao": "Todos os termos de cada especificação (M1, M2, M4, M5 por ciclo, M7) entram no portão; os EP de MV e por candidato são registrados sem entrar nele. Qualquer falha para a execução inteira, com o código da primeira especificação que falhou, e nada é calculado."
    },
    {
      "data": "2026-10-26",
      "item": "Rejeição nas sensibilidades",
      "situacao": "O §3 manda BKY entre as linhas P1h-3 sem dizer o nível.",
      "resolucao": "q BKY e a marca 'rejeita a 5%' (q < 0,05) são registrados como leitura de robustez; a única linha com decisão é o P1h-1."
    }
  ],
