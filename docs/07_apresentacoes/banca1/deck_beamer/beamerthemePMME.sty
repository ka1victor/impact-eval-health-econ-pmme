% ---------------------------------------------------------------------------
% beamerthemePMME.sty — identidade visual dos decks do projeto: institucional
% Insper (github.com/padsInsper/quarto-insper-theme) com a paleta do PMM-E
% como acento
%
% Tema-base: paleta, fonte de destaque, navbar de duas linhas no topo,
% frametitle com barra amarela, rodape com rastreio e tira de quatro cores,
% imagem de fundo por frame (\pmmefundo), layouts em 2 e 4 partes (pmmeduas,
% pmmequatro, pmmeparte) e os utilitarios de composicao usados no corpo dos
% frames (\fonte, \lead, \num, destaque, colunas L/Z).
%
% A capa (\pmmecapa, em pmmecapa.sty) e o sumario (\pmmesumario, em
% pmmesumario.sty) sao pacotes auxiliares carregados ao final, se existirem.
%
% Uso:  \usetheme{PMME}   (o diretorio deste arquivo deve estar em TEXINPUTS;
%       scripts/apresentacao/build_deck_beamer.sh ja faz isso).
% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemePMME}[2026/09/19 v2.0 Tema PMME/Insper para Beamer]

\mode<presentation>

\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{amssymb}
\RequirePackage{array}
\RequirePackage{tabularx}

% --- paleta (nomes sao contrato com pmmecapa.sty e pmmesumario.sty) ---------
% Valores amostrados pixel a pixel da peca oficial do PMM-E (banner com bloco
% azul, titulo amarelo e tira de quatro cores). Azul, amarelo do titulo, verde
% e vermelho sao exatos; os azuis escuro/claro/palido sao derivados do azul.
\definecolor{pmmeAzul}{HTML}{0D28A9}          % bloco da capa, navbar, estrutura
\definecolor{pmmeAzulEscuro}{HTML}{081A72}    % derivado: linha 1 da navbar, \lead
\definecolor{pmmeAzulClaro}{HTML}{E4E8F7}     % derivado: filetes, anel do sumario
\definecolor{pmmeAzulPalido}{HTML}{F2F4FB}    % derivado: fundo de bloco e rodape
\definecolor{pmmeAmarelo}{HTML}{EDB601}       % titulo da capa, chevrons, barras
\definecolor{pmmeAmareloFaixa}{HTML}{F1BB00}  % tira inferior (um pouco mais claro)
\definecolor{pmmeVerde}{HTML}{00B300}
\definecolor{pmmeVermelho}{HTML}{C40000}
\definecolor{pmmeCinzaTexto}{HTML}{2E2E2E}
\definecolor{pmmeCinzaFonte}{HTML}{6B6B6B}

% Identidade institucional do Insper, do tema oficial para Quarto
% (insper.scss e insper-bg.png, amostrados): preto, vermelho, verde-menta,
% listras verde-acinzentadas sobre creme. E a base do deck; a paleta PMM-E
% acima fica como acento e para a capa alternativa \pmmecapa.
\definecolor{insperPreto}{HTML}{1D1D1B}       % texto, títulos, navbar (linha 1)
\definecolor{insperVermelho}{HTML}{E50505}    % acento: losangos, barra do título, \num
\definecolor{insperVerde}{HTML}{3ACC9F}       % acento secundário: blocos example
\definecolor{insperListra}{HTML}{7F8F85}      % listras do gráfico institucional
\definecolor{insperCreme}{HTML}{F2E8DC}       % fundo das listras
\definecolor{insperCinza}{HTML}{6B6B6B}       % texto secundário, fontes
\definecolor{insperCinzaClaro}{HTML}{E6E6E6}  % filetes
\definecolor{insperCinzaFundo}{HTML}{F5F5F5}  % fundo de blocos e rodapé

% aliases usados no corpo dos frames
\colorlet{cinzaFonte}{insperCinza}
\colorlet{cinzaTexto}{insperPreto}

% --- fontes ------------------------------------------------------------------
% Tres familias, como no tema oficial do Insper (Inter no corpo, serifa de
% exibicao nos titulos):
%   corpo           Inter (OFL), em fontes/                       [LuaLaTeX]
%                   Latin Modern Sans                             [pdflatex]
%   \pmmeDisplay    Playfair Display (OFL), em fontes/: titulos, capa, sumario,
%                   divisorias. Substitui a GT Ultra Fine do tema oficial, que
%                   e comercial e nao pode ser redistribuida.  [LuaLaTeX]
%                   TeX Gyre Pagella (qpl)                        [pdflatex]
%   \pmmeCondensada Oswald (OFL), em fontes/: so a capa alternativa \pmmecapa,
%                   que reproduz o banner do PMM-E.               [LuaLaTeX]
%                   TeX Gyre Heros Condensed (qhvc)               [pdflatex]
%
% O caminho de fontes/ e declarado no .tex com \pmmefontes{dir/} (relativo a
% raiz, como os demais assets); as familias sao resolvidas em \AtBeginDocument.
% Sem os arquivos, cai em fontes do sistema com aviso no log.
\RequirePackage{iftex}
\def\pmme@fontes{}
\newcommand{\pmmefontes}[1]{\def\pmme@fontes{#1}}
\newcommand{\pmmeDisplay}{\pmme@displayfamily}
\newcommand{\pmmeCondensada}{\pmme@condfamily}
\ifPDFTeX
  \def\pmme@displayfamily{\fontfamily{qpl}\selectfont}
  \def\pmme@condfamily{\fontfamily{qhvc}\selectfont}
  \def\pmmeDisplayNome{TeX Gyre Pagella}
  \def\pmmeCorpoNome{Latin Modern Sans}
\else
  \RequirePackage{fontspec}
  \def\pmme@displayfamily{\rmfamily}% ate \AtBeginDocument
  \def\pmme@condfamily{\sffamily}
  \AtBeginDocument{%
    \let\pmme@displayfamily\relax
    \let\pmme@condfamily\relax
    \IfFileExists{\pmme@fontes Inter-Regular.otf}{%
      \setsansfont{Inter}[Path=\pmme@fontes, Extension=.otf,
        UprightFont=*-Regular, BoldFont=*-Bold,
        ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic,
        Ligatures=TeX]%
      \def\pmmeCorpoNome{Inter}%
    }{%
      \def\pmmeCorpoNome{Latin Modern Sans}%
      \PackageWarningNoLine{beamerthemePMME}{Inter nao encontrada em
        '\pmme@fontes'; corpo em Latin Modern Sans}%
    }%
    \IfFileExists{\pmme@fontes PlayfairDisplay-Bold.ttf}{%
      \newfontfamily\pmme@displayfamily{PlayfairDisplay}[%
        Path=\pmme@fontes, Extension=.ttf,
        UprightFont=*-Regular, BoldFont=*-Bold,
        ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic,
        Ligatures=TeX]%
      \def\pmmeDisplayNome{Playfair Display}%
    }{%
      \newfontfamily\pmme@displayfamily{TeX Gyre Pagella}[Ligatures=TeX]%
      \def\pmmeDisplayNome{TeX Gyre Pagella}%
      \PackageWarningNoLine{beamerthemePMME}{Playfair Display nao encontrada em
        '\pmme@fontes'; usando TeX Gyre Pagella}%
    }%
    \IfFileExists{\pmme@fontes Oswald-Bold.ttf}{%
      \newfontfamily\pmme@condfamily{Oswald}[%
        Path=\pmme@fontes, Extension=.ttf,
        UprightFont=*-Regular, BoldFont=*-Bold,
        ItalicFont=*-Regular, ItalicFeatures={FakeSlant=0.14},
        BoldItalicFont=*-Bold, BoldItalicFeatures={FakeSlant=0.14},
        Ligatures=TeX]%
    }{%
      \newfontfamily\pmme@condfamily{TeX Gyre Heros Cn}[Ligatures=TeX]%
    }%
  }
\fi

