% --- blocos: espacamento compacto ------------------------------------------
% Igual ao template 'rounded' do beamer, mas com \smallskipamount (e nao
% \medskipamount) antes do bloco: a navbar consome altura e os frames sao
% densos. Sem sombra.
\setbeamertemplate{block begin}{%
  \par\vskip\smallskipamount%
  \begin{beamerboxesrounded}[upper=block title,lower=block body,shadow=false]%
    {\raggedright\usebeamerfont*{block title}\insertblocktitle}%
    \raggedright%
    \usebeamerfont{block body}%
}
\setbeamertemplate{block end}{\end{beamerboxesrounded}\vskip\smallskipamount}
\setbeamertemplate{block alerted begin}{%
  \par\vskip\smallskipamount%
  \begin{beamerboxesrounded}[upper=block title alerted,lower=block body alerted,shadow=false]%
    {\raggedright\usebeamerfont*{block title alerted}\insertblocktitle}%
    \raggedright%
    \usebeamerfont{block body alerted}%
}
\setbeamertemplate{block alerted end}{\end{beamerboxesrounded}\vskip\smallskipamount}
\setbeamertemplate{block example begin}{%
  \par\vskip\smallskipamount%
  \begin{beamerboxesrounded}[upper=block title example,lower=block body example,shadow=false]%
    {\raggedright\usebeamerfont*{block title example}\insertblocktitle}%
    \raggedright%
    \usebeamerfont{block body example}%
}
\setbeamertemplate{block example end}{\end{beamerboxesrounded}\vskip\smallskipamount}

% --- marcadores ------------------------------------------------------------
\setbeamertemplate{itemize item}{\raisebox{0.15ex}{\scriptsize$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\raisebox{0.15ex}{\scriptsize$\bullet$}}
\setlength{\leftmargini}{1.4em}
\setlength{\leftmarginii}{1.2em}

% --- dimensoes da identidade -----------------------------------------------
% Margem lateral dos elementos de moldura (navbar, frametitle, rodape).
\newlength{\pmmeMargem}
\setlength{\pmmeMargem}{0.43cm}          % ~1.1em do corpo em 11pt
% Respiro acima do titulo do frame (substitui a altura que era da navbar).
\newlength{\pmmeTituloTopo}\setlength{\pmmeTituloTopo}{0.26cm}
% Filete vermelho na borda inferior.
\newlength{\pmmeTiraAlt}\setlength{\pmmeTiraAlt}{1.2pt}

% Losango vermelho que marca a secao/subsecao corrente na navbar.
\newcommand{\pmmeLosango}{%
  \tikz[baseline=-0.5ex]{\fill[insperVermelho,rotate=45]
    (-0.3ex,-0.3ex) rectangle (0.3ex,0.3ex);}%
}

% --- trilha de secoes, no rodape -------------------------------------------
% Ate 19/09/2026 a moldura tinha uma navbar de duas linhas no topo, que
% custava 0.60 cm dos 9 cm de pagina e repetia o que o rastreio do rodape ja
% dizia. A trilha abaixo da a mesma informacao -- onde estamos e quanto falta
% -- numa linha do rodape, que existiria de qualquer modo.
%
% Uso, no preambulo do deck, na ordem das \section:
%   \pmmeselecaoitem{Motivacao e Pergunta}
%   \pmmeselecaoitem{Literatura e Modelo}
%   \pmmeselecaoitem{Hipotese e Viabilidade}
%
% Os nomes sao os curtos, os mesmos que o documento canonico usa na linha de
% rastreio de cada slide. A secao corrente sai em negrito preto, precedida do
% losango vermelho e seguida da subsecao; as demais, em cinza. Sem nenhum
% item registrado, o rodape cai no \rastreio{...} manual.
\newcount\pmme@selecaon  \pmme@selecaon=0
\newcount\pmme@selecaoi
\newcommand{\pmmeselecaoitem}[1]{%
  \global\advance\pmme@selecaon by 1
  \expandafter\gdef\csname pmme@selecao\the\pmme@selecaon\endcsname{#1}}

\newcommand{\pmme@selecaosep}{%
  \hskip0.5em\raisebox{-0.04em}{\color{insperCinzaClaro}%
    \vrule width0.5pt height0.62em depth0.1em}\hskip0.5em}

\newcommand{\pmme@trilha}{%
  \pmme@selecaoi=0
  \loop\ifnum\pmme@selecaoi<\pmme@selecaon
    \advance\pmme@selecaoi by 1
    \ifnum\pmme@selecaoi=\insertsectionnumber\relax
      \pmmeLosango\hskip0.34em
      {\bfseries\color{insperPreto}\the\pmme@selecaoi.~%
       \csname pmme@selecao\the\pmme@selecaoi\endcsname}%
      \ifx\insertsubsectionhead\@empty\else
        {\color{insperPreto}\,$\cdot$\,\insertsubsectionhead}%
      \fi
    \else
      {\color{insperCinza}\the\pmme@selecaoi.~%
       \csname pmme@selecao\the\pmme@selecaoi\endcsname}%
    \fi
    \ifnum\pmme@selecaoi<\pmme@selecaon\pmme@selecaosep\fi
  \repeat}

% Sem navbar no topo.
\setbeamertemplate{headline}{}

% --- frametitle: texto preto sobre branco, barra vermelha, filete abaixo ---
% Sem navbar acima, o titulo precisa de um respiro no topo da pagina
% (\pmmeTituloTopo). O titulo e um paragrafo em \vtop ao
% lado da barra; se quebrar em duas linhas, a segunda alinha com a primeira.
% A caixa tem a largura do papel e e deslocada para a borda esquerda do
% mesmo modo que o beamercolorbox faz (glue negativa nas margens).
% Struts e \vskip calibrados para a Playfair Display (ascendentes altas,
% descendentes longas): frames densos estouram a altura com folga maior.
\newlength{\pmmeBarraLarg}\setlength{\pmmeBarraLarg}{0.11cm}
\newlength{\pmmeBarraGap}\setlength{\pmmeBarraGap}{0.30cm}
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \setbox\@tempboxa=\vbox{%
    \hsize=\paperwidth%
    \vskip\pmmeTituloTopo%
    \hbox{%
      \hskip\pmmeMargem%
      {\color{insperVermelho}\usebeamerfont{frametitle}%
       \vrule width\pmmeBarraLarg height0.72em depth0.16em}%
      \hskip\pmmeBarraGap%
      % cor e fonte fora do \vtop: um whatsit como primeiro item zeraria a
      % altura do \vtop e jogaria a linha inteira para a profundidade.
      {\usebeamerfont{frametitle}\pmmeDisplay\usebeamercolor[fg]{frametitle}%
      \vtop{%
        \hsize=\dimexpr\paperwidth-2\pmmeMargem-\pmmeBarraLarg-\pmmeBarraGap\relax%
        \@arrayparboxrestore\raggedright\parindent\z@\parskip\z@%
        \usebeamerfont{frametitle}\pmmeDisplay%
        \vrule width\z@ height0.75em depth0.18em\insertframetitle%
        \vrule width\z@ height0.75em depth0.18em\par%
        \ifx\insertframesubtitle\@empty\else%
          \vskip0.05em%
          {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
           \strut\insertframesubtitle\strut\par}%
        \fi}}%
    }%
    \nointerlineskip%
    \vskip0.03cm%
    \hbox{\color{insperCinzaClaro}\vrule width\paperwidth height0.6pt}%
  }%
  \hbox to\textwidth{\hskip0pt minus\beamer@leftmargin\relax%
    \box\@tempboxa\hskip0pt minus\beamer@rightmargin\relax}%
}

% --- rodape: filete cinza, rastreio + contador + logo do Insper, filete
% vermelho fino na borda inferior (o acento do tema oficial) -------------------
\def\rastreiotexto{}
\newcommand{\rastreio}[1]{\gdef\rastreiotexto{#1}}
\providecommand{\pmme@insperlogo}{}
\newcommand{\pmme@rodapelogo}{%
  \IfFileExists{\pmme@insperlogo}%
    {\raisebox{-0.06cm}{\includegraphics[height=0.27cm]{\pmme@insperlogo}}}%
    {{\pmmeDisplay\bfseries\fontsize{7.5}{8}\selectfont\color{insperPreto}Insper}}}

\setbeamertemplate{footline}{%
  \hbox{\color{insperCinzaClaro}\vrule width\paperwidth height0.6pt}%
  \nointerlineskip
  % Alturas absolutas: o 'ex' aqui e avaliado numa fonte minuscula.
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.30cm,dp=0.14cm,%
    leftskip=\pmmeMargem,rightskip=\pmmeMargem]{rodape}%
    \fontsize{6.5}{7}\selectfont
    \ifnum\pmme@selecaon>0 \pmme@trilha\else\rastreiotexto\fi
    \hfill{\fontsize{8}{8}\selectfont\color{insperCinza}%
      \insertframenumber\,/\,\inserttotalframenumber}%
    \hskip0.5cm\pmme@rodapelogo%
  \end{beamercolorbox}%
  \hbox{\color{insperVermelho}\vrule width\paperwidth height\pmmeTiraAlt}%
}

% --- utilitarios de composicao ---------------------------------------------
% Unico formato de fonte no deck: filete fino, rotulo em negrito, alinhado a
% esquerda, corpo reduzido. Vale tambem para os frames com figura.
\newcommand{\fonte}[1]{%
  \vfill
  {\color{insperCinzaClaro}\rule{\textwidth}{0.6pt}}\par
  \vspace{0.15em}
  {\color{insperCinza}\scriptsize #1\par}%
}

\newcommand{\lead}[1]{{\color{insperPreto}\bfseries #1}}
\newcommand{\num}[1]{{\color{insperVermelho}\bfseries #1}}

% caixa de destaque: fundo preto, texto branco, sem sombra
\newenvironment{destaque}[1][0.95\textwidth]%
  {\begin{center}\begin{beamercolorbox}[wd=#1,sep=0.55em,rounded=true]{block title}\centering}%
  {\end{beamercolorbox}\end{center}}

% --- etiquetas em caixa alta espacada --------------------------------------
% \pmmeRotulo{...}      rotulo solto, cinza, sobre o conteudo que ele nomeia
% \pmmeEtiqueta{...}    o mesmo, dentro de uma pastilha cinza-clara
\newcommand{\pmmeRotulo}[1]{%
  {\color{insperCinza}\fontsize{6}{7.5}\selectfont\bfseries
   \textls[60]{\MakeUppercase{#1}}}}
\newcommand{\pmmeEtiqueta}[1]{%
  \tikz[baseline=0pt]{\node[fill=insperCinzaFundo, rounded corners=1.5pt,
    inner xsep=0.6em, inner ysep=0.34em, inner ysep=0.34em]{\pmmeRotulo{#1}};}}

% --- equacao em cartao ------------------------------------------------------
% \pmmeequacao[<fonte da equacao>]{<corpo em modo matematico>}
%
% A equacao vira o ancoradouro visual do frame: quadro branco de borda fina,
% corpo em \displaystyle, e a referencia numa etiqueta acima, no lugar de
% descer para a linha de fontes do rodape. Sem o argumento opcional, sai so o
% quadro. A largura padrao e ajustavel com \pmmeequacaolargura.
\newlength{\pmme@eqlarg}\setlength{\pmme@eqlarg}{0.94\textwidth}
\newlength{\pmme@eqfolga}\setlength{\pmme@eqfolga}{0.45em}  % respiro interno
\newcommand{\pmmeequacaolargura}[1]{\setlength{\pmme@eqlarg}{#1}}
\newcommand{\pmmeequacaofolga}[1]{\setlength{\pmme@eqfolga}{#1}}
\newcommand{\pmmeequacao}[2][]{%
  \par\vskip0.2em
  \noindent\hfill
  \begin{minipage}{\pmme@eqlarg}%
    \if\relax\detokenize{#1}\relax\else
      \noindent\pmmeEtiqueta{#1}\par\vskip0.22em
    \fi
    \noindent
    \begin{tikzpicture}
      \node[draw=insperCinzaClaro, line width=0.6pt, fill=white,
            rounded corners=2pt, inner xsep=0.8em, inner ysep=\pmme@eqfolga,
            text width=\dimexpr\pmme@eqlarg-1.6em-1.2pt\relax, align=center]
        {$\displaystyle #2$};
    \end{tikzpicture}%
  \end{minipage}%
  \hfill\null\par\vskip0.2em}

% --- fichas de termos -------------------------------------------------------
% Glossario de simbolos como fichas numa grade, no lugar de uma tabela de duas
% colunas: mesma informacao, menos altura.
%
%   \begin{pmmefichas}[3]          % 2 (padrao) ou 3 colunas
%     \pmmeficha{$B_n$}{amenidades}
%     \pmmeficha{$w_i$}{salario}
%   \end{pmmefichas}
%
% \pmmefichaaltura{2.6em} antes do ambiente fixa a altura de todas as fichas,
% para que os fundos cinzentos fiquem iguais quando as definicoes tem numeros
% de linhas diferentes; 0pt volta a altura natural.
\newcount\pmme@fichan
\newlength{\pmme@fichalarg}
\newlength{\pmme@fichah}\setlength{\pmme@fichah}{0.02\textwidth}  % vao horizontal
\newlength{\pmme@fichav}\setlength{\pmme@fichav}{0.4em}           % vao vertical
\newlength{\pmme@fichaalt}\setlength{\pmme@fichaalt}{0pt}        % 0pt = natural
\newcommand{\pmmefichaaltura}[1]{\setlength{\pmme@fichaalt}{#1}}
\def\pmme@fichacol{2}
\newcommand{\pmmefichafonte}{\fontsize{7.5}{9}\selectfont}
\newenvironment{pmmefichas}[1][2]{%
  \global\pmme@fichan=0 \def\pmme@fichacol{#1}%
  \setlength{\pmme@fichalarg}%
    {\dimexpr(\textwidth-\numexpr#1-1\relax\pmme@fichah)/#1\relax}%
  \par\noindent\ignorespaces}{\par}
\newcommand{\pmmeficha}[2]{%
  \global\advance\pmme@fichan by 1
  \begin{minipage}[t]{\pmme@fichalarg}%
    \begin{beamercolorbox}[wd=\pmme@fichalarg,sep=0.38em,rounded=true]{ficha}%
      \pmmefichafonte\raggedright
      \ifdim\pmme@fichaalt>0pt
        \begin{minipage}[t][\pmme@fichaalt][t]%
          {\dimexpr\pmme@fichalarg-0.76em\relax}%
          \pmmefichafonte\raggedright
          {\bfseries\color{insperPreto}#1}\,\ {\color{insperCinza}#2}%
        \end{minipage}%
      \else
        {\bfseries\color{insperPreto}#1}\,\ {\color{insperCinza}#2}%
      \fi
    \end{beamercolorbox}%
  \end{minipage}%
  \ifnum\pmme@fichan=\pmme@fichacol\relax
    \par\vskip\pmme@fichav\global\pmme@fichan=0
  \else
    \hskip\pmme@fichah
  \fi
  \ignorespaces}

% --- selos ------------------------------------------------------------------
% Pastilha curta que da o sinal de um termo sem obrigar a ler a expressao.
% \pmmeselo{NEUTRO}  \pmmeselov{ELEVA}  \pmmeselor{REDUZ}
\newcommand{\pmme@selo}[3]{%
  \tikz[baseline=-0.32ex]{\node[fill=#1, rounded corners=1.5pt,
    inner xsep=0.45em, inner ysep=0.2em, text=#2,
    font=\fontsize{6}{6}\bfseries]{\textls[50]{\MakeUppercase{#3}}};}}
\newcommand{\pmmeselo}[1]{\pmme@selo{insperPreto}{white}{#1}}
\newcommand{\pmmeselov}[1]{\pmme@selo{insperVerde}{insperPreto}{#1}}
\newcommand{\pmmeselor}[1]{\pmme@selo{insperVermelho}{white}{#1}}

% --- caixa de saida ---------------------------------------------------------
% \pmmesaida[<largura>]{<rotulo>}{<texto>}
% Fundo preto, rotulo em negrito branco: o que a equacao ou o bloco produz.
% Distingue-se de `destaque`, que e a citacao em destaque do documento
% canonico, por ser alinhada a esquerda e nomear a saida.
\newcommand{\pmmesaida}[3][\textwidth]{%
  \begin{beamercolorbox}[wd=#1,sep=0.5em,rounded=true]{block title}%
    \raggedright\small\textbf{#2}\ #3%
  \end{beamercolorbox}}

% --- veu com faixa ----------------------------------------------------------
% O recurso do deck entregue na banca 1: a conclusao nasce da evidencia. Num
% build posterior, desbota tudo o que ja esta na tela e poe a frase numa
% faixa preta de sangria total.
%
%   \only<2>{\pmmeveuy{6.15}\pmmeveu{A pergunta ...}%
%            \pmmeveubloco[4.9]{... o que mais entra no build 2 ...}}
%
% Tem de vir DEPOIS do conteudo que desbota, porque as duas camadas sao
% desenhadas na ordem em que aparecem no frame. \pmmeveubloco posiciona o
% resto do build por cima do veu, ja que o fluxo normal do frame continuaria
% abaixo do conteudo anterior.
\def\pmme@veuy{4.5}
\newcommand{\pmmeveuy}[1]{\def\pmme@veuy{#1}}
\newcommand{\pmmeveufaixafonte}{\fontsize{15}{19}\pmmeDisplay\bfseries}
\newcommand{\pmmeveu}[2][0.88]{%
  \begin{tikzpicture}[remember picture,overlay,
                      shift={(current page.south west)},x=1cm,y=1cm]
    \fill[white,opacity=#1] (0,0) rectangle (16,9);
    \node[name=pmmefaixa, fill=insperPreto, minimum width=16cm,
          text width=13.4cm, align=center, text=white, inner ysep=0.45cm,
          font=\pmmeveufaixafonte] at (8,\pmme@veuy) {#2};
    \fill[insperVermelho]
      (pmmefaixa.north west) rectangle ([yshift=-0.05cm]pmmefaixa.north east);
  \end{tikzpicture}}
\newcommand{\pmmeveubloco}[2][3.1]{%
  \begin{tikzpicture}[remember picture,overlay,
                      shift={(current page.south west)},x=1cm,y=1cm]
    \node[anchor=north west, inner sep=0, text width=14.4cm, align=left]
      at (0.8,#1) {\raggedright #2};
  \end{tikzpicture}}

\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}

\renewcommand{\arraystretch}{1.18}

\setbeamertemplate{caption}{\insertcaption}

% --- imagem de fundo em um frame -----------------------------------------------
% \pmmefundo[opacidade]{arquivo}  antes do \begin{frame}; vale ate \pmmesemfundo
% (ou ate o fim do grupo, se usado entre chaves). A imagem cobre a pagina
% inteira, recortada e centrada (como "cover" em CSS), esmaecida para o texto
% continuar legivel. Navbar, titulo e rodape ficam por cima. Opacidade padrao
% 0.18; use 1 para foto plena em frame [plain].
%
%   {\pmmefundo[0.15]{docs/.../assets/fundo.jpg}
%    \begin{frame}{Titulo} ... \end{frame}}
\newsavebox{\pmme@fundobox}
\newcommand{\pmme@cobrir}[1]{%
  % escala para cobrir \paperwidth x \paperheight, preservando a proporcao
  \sbox{\pmme@fundobox}{\includegraphics[width=\paperwidth]{#1}}%
  \ifdim\ht\pmme@fundobox<\paperheight
    \sbox{\pmme@fundobox}{\includegraphics[height=\paperheight]{#1}}%
  \fi
  \usebox{\pmme@fundobox}}
\newcommand{\pmmefundo}[2][0.18]{%
  \setbeamertemplate{background canvas}{%
    \IfFileExists{#2}{%
      \begin{tikzpicture}
        \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
        \clip (0,0) rectangle (\paperwidth,\paperheight);
        \node[anchor=center,inner sep=0pt,outer sep=0pt,opacity=#1]
          at (0.5\paperwidth,0.5\paperheight) {\pmme@cobrir{#2}};
      \end{tikzpicture}}{%
      \color{white}\vrule width\paperwidth height\paperheight}%
  }}
\newcommand{\pmmesemfundo}{\setbeamertemplate{background canvas}[default]}

% --- layouts em partes: 2 (lado a lado) e 4 (grade 2x2) ------------------------
% Cada parte tem um titulo curto na fonte de destaque, um traco vermelho e o
% corpo. As partes sao minipages alinhadas pelo topo.
%
%   \begin{pmmeduas}                 \begin{pmmequatro}
%     \begin{pmmeparte}{A} ... \end{pmmeparte}      % 4 partes: A B / C D
%     \begin{pmmeparte}{B} ... \end{pmmeparte}
%   \end{pmmeduas}                   \end{pmmequatro}
%
% Opcional: pmmeduas[altura] e pmmequatro[altura] fixam a altura de cada parte
% (padrao: natural em duas; 0.36\textheight em quatro). Parte sem titulo:
% \begin{pmmeparte}{} . Com linha metrica, como em \pmmebuild:
% \begin{pmmeparte}[R$ por mes, ciclo 1]{Valor da bolsa} .
\newlength{\pmme@partelarg}
\newlength{\pmme@partealt}
\newlength{\pmme@parteh}\setlength{\pmme@parteh}{0.03\textwidth}   % vao horizontal
\newlength{\pmme@partev}\setlength{\pmme@partev}{0.55em}           % vao vertical
\newcount\pmme@parten
\def\pmme@partecol{2}
\def\pmme@partefonte{}
\newcommand{\pmmepartetitulofonte}{\pmmeDisplay\bfseries\small}
\newenvironment{pmmeparte}[2][]{%
  \global\advance\pmme@parten by 1
  \ifdim\pmme@partealt>0pt
    \begin{minipage}[t][\pmme@partealt][t]{\pmme@partelarg}%
  \else
    \begin{minipage}[t]{\pmme@partelarg}%
  \fi
  \raggedright\pmme@partefonte
  \if\relax\detokenize{#2}\relax\else
    \pmme@titulobloco{#1}{#2}\vskip0.35em
  \fi
  \ignorespaces}{%
  \end{minipage}%
  \ifnum\pmme@parten=\pmme@partecol\relax
    \par\vskip\pmme@partev\global\pmme@parten=0
  \else
    \hskip0pt plus1fill\relax
  \fi
  \ignorespacesafterend}
% Titulo de build (\only<n>) dentro de um frame: o mesmo formato do titulo de
% pmmeparte -- Playfair negrito, traco vermelho -- para que o `###` do
% documento canonico tenha uma marca visual constante no deck.
%
%   \pmmebuild[Medicos por 100 mil habitantes, por UF, 2024]{Onde eles estao}
%
% O argumento opcional e a LINHA METRICA: o que esta medido, em que unidade e
% em que data. Vai em cinza miudo sob o titulo, antes do traco. Serve sobretudo
% aos builds com figura, cuja legenda impressa no PNG e pequena demais para
% projecao.
\newcommand{\pmmebuildmetricafonte}{\fontsize{6.8}{8}\selectfont}
\newcommand{\pmme@titulobloco}[2]{%
  {\pmmepartetitulofonte\color{insperPreto}#2\par}%
  \if\relax\detokenize{#1}\relax\else
    \nointerlineskip\vskip0.14em
    {\color{insperCinza}\pmmebuildmetricafonte#1\par}%
  \fi
  \nointerlineskip\vskip0.18em
  {\color{insperVermelho}\rule{1.6em}{0.09cm}\par}}
\newcommand{\pmmebuild}[2][]{%
  \pmme@titulobloco{#1}{#2}\vskip0.25em}

% A mesma linha metrica, solta: para o build que traz duas figuras de metricas
% diferentes, em que uma linha so no titulo nao daria conta.
\newcommand{\pmmemetrica}[1]{%
  {\color{insperCinza}\pmmebuildmetricafonte\raggedright #1\par}\vskip0.15em}
\newenvironment{pmmeduas}[1][0pt]{%
  \global\pmme@parten=0 \def\pmme@partecol{2}\def\pmme@partefonte{}%
  \setlength{\pmme@partealt}{#1}%
  \setlength{\pmme@partelarg}{\dimexpr(\textwidth-\pmme@parteh)/2\relax}%
  \par\noindent\ignorespaces}{\par}
\newenvironment{pmmequatro}[1][0.36\textheight]{%
  \global\pmme@parten=0 \def\pmme@partecol{2}\def\pmme@partefonte{\small}%
  \setlength{\pmme@partealt}{#1}%
  \setlength{\pmme@partelarg}{\dimexpr(\textwidth-\pmme@parteh)/2\relax}%
  \par\noindent\ignorespaces}{\par}

% --- pacotes auxiliares da identidade (capa e sumario), se presentes -------
\IfFileExists{pmmecapa.sty}{\RequirePackage{pmmecapa}}{}
\IfFileExists{pmmesumario.sty}{\RequirePackage{pmmesumario}}{}
\IfFileExists{pmmeinsper.sty}{\RequirePackage{pmmeinsper}}{}

